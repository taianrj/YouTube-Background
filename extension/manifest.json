{
  "manifest_version": 3,
  "name": "YouTube Background — Ponte para Windows",
  "version": "1.0.0",
  "description": "Conecta o YouTube ao aplicativo de atalhos globais do Windows.",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "incognito": "not_allowed",
  "key": ""
}
